<Window x:Class="HSR_Overlay.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:HSR_Overlay"
        xmlns:overlay="clr-namespace:HSR_Overlay.Util"
        xmlns:mel="clr-namespace:Microsoft.Extensions.Logging;assembly=Microsoft.Extensions.Logging.Abstractions"
        mc:Ignorable="d"
        Title="HSR Overlay"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="False"
        ShowActivated="False"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Width="800" Height="600">
    <Grid>
        <!-- Passive HUD (click-through) -->
        <TextBlock Text="Overlay HUD" Foreground="White" FontSize="18"
                   HorizontalAlignment="Right" VerticalAlignment="Top"
                   Margin="0,10,20,0" Opacity="0.9"
                   IsHitTestVisible="False"/>

        <!-- Relic popup, noninteractable-->
        <Border x:Name="RelicPopup"
          Visibility="Collapsed"
          Margin="166,0,0,0"
          HorizontalAlignment="Left"
          VerticalAlignment="Center"
          Background="#AA000000"
          CornerRadius="8"
          Padding="12" Height="96" Width="95">
            <TextBlock x:Name="RelicText"
               Text="—"
               TextWrapping="Wrap"
               MaxWidth="520"
               FontSize="16"
               Foreground="White"
               Opacity="0.95" />
        </Border>

        <!-- Settings button (interactive) -->
        <Border x:Name="GearButtonHost"
          HorizontalAlignment="Left" VerticalAlignment="Top"
          Margin="12" Padding="6" CornerRadius="6"
          Background="#66000000"
          overlay:OverlayHitTest.IsInteractive="True">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="⚙" FontSize="16" Margin="0,0,6,0" VerticalAlignment="Center"/>
                <TextBlock Text="Menu" FontSize="12" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Simple flyout-style panel -->
        <Border x:Name="ConfigPanel"
          Visibility="Collapsed"
          HorizontalAlignment="Left" VerticalAlignment="Top"
          Margin="12,48,0,0" Padding="12" CornerRadius="8"
          Background="#CC101010"
          overlay:OverlayHitTest.IsInteractive="True">
            <StackPanel Width="260" >
                <TextBlock Text="Overlay Settings" FontSize="14" FontWeight="Bold" Margin="0,0,0,8"/>

                <!-- Enable Relic Popup -->
                <CheckBox Content="Enable relic popup"
                IsChecked="{Binding EnableRelicPopup, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                <!-- Capture interval -->
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <TextBlock Text="Capture interval (ms):" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox Width="70"
                 Text="{Binding CaptureIntervalMs, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>

                <!-- Log level -->
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <TextBlock Text="Log level:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox Width="110"
          SelectedValue="{Binding LogLevel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
          SelectedValuePath="Tag">
                        <ComboBoxItem Content="Trace" Tag="{x:Static mel:LogLevel.Trace}" />
                        <ComboBoxItem Content="Debug" Tag="{x:Static mel:LogLevel.Debug}" />
                        <ComboBoxItem Content="Info"  Tag="{x:Static mel:LogLevel.Information}" />
                        <ComboBoxItem Content="Warn"  Tag="{x:Static mel:LogLevel.Warning}" />
                        <ComboBoxItem Content="Error" Tag="{x:Static mel:LogLevel.Error}" />
                    </ComboBox>
                </StackPanel>

                <!-- Actions -->
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0" HorizontalAlignment="Right">
                    <Button x:Name="BtnSave"
                Content="Save"
                Padding="10,4"
                overlay:OverlayHitTest.IsInteractive="True"/>
                    <Button x:Name="BtnClose"
                Content="Close"
                Margin="8,0,0,0" Padding="10,4"
                overlay:OverlayHitTest.IsInteractive="True"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
